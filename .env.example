# Authored by: Shubham Tapadiya
# Created: 2026-09-02
# Updated: 2026-09-02
#
# Copy to .env and adjust for your environment. Never commit a real .env.

# --- Message broker ---
STREAM_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Storage ---
TIMESCALE_DSN=postgresql://camtrack:camtrack@localhost:5432/camtrack

# --- Inference ---
DETECTOR_WEIGHTS_PATH=models/yolov8n.onnx
DETECTOR_DEVICE=cpu
DETECTOR_USE_ONNX_RUNTIME=true
MAX_BATCH_SIZE=8
MAX_BATCH_WAIT_MS=40

# --- Re-identification ---
REID_ENABLED=true
REID_WEIGHTS_PATH=models/reid_resnet18.onnx

# --- Ingestion ---
CAMERA_CONFIG_PATH=configs/cameras.yaml

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# --- Observability ---
LOG_LEVEL=INFO
SERVICE_NAME=camtrack

# Dashboard service image: FastAPI analytics API + static UI.

FROM python:3.11-slim AS base

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/

ENV PYTHONUNBUFFERED=1
EXPOSE 8080
ENTRYPOINT ["uvicorn", "src.dashboard.app:app", "--host", "0.0.0.0", "--port", "8080"]
